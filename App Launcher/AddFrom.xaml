<Window x:Class="App_Launcher.AddFrom"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Select items to add" Height="450" Width="500" FontSize="14" Loaded="Window_Loaded" SizeChanged="Window_SizeChanged" Icon="Images/add.png">
    <Grid>
        <Grid.ContextMenu>
            <ContextMenu>
                <MenuItem Header="Check All" Click="CheckAll_Click"/>
                <MenuItem Header="Uncheck All" Click="UncheckAll_Click"/>
                <MenuItem Header="Invert checked items" Click="Invert_Click"/>
            </ContextMenu>
        </Grid.ContextMenu>
        <ListBox x:Name="app_list" Margin="5,5,5,40"/>
        <Button Content="Add" HorizontalAlignment="Right" Margin="0,0,10,10" VerticalAlignment="Bottom" Width="80" Height="25" Background="{x:Null}" IsDefault="True" Click="Add_Click"/>
        <Button Content="Cancel" HorizontalAlignment="Right" Margin="0,0,95,10" VerticalAlignment="Bottom" Width="80" Height="25" Background="{x:Null}" IsCancel="True" Click="Cancel_Click"/>
        <TextBlock HorizontalAlignment="Left" Margin="5,384,0,0" TextWrapping="Wrap" Text="$$ APPS and $$$ Checked" VerticalAlignment="Top" Foreground="DarkBlue"/>

    </Grid>
</Window>
