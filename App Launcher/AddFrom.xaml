<Window x:Class="App_Launcher.AddFrom"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Select items to add" Height="450" Width="500" FontSize="14" Loaded="Window_Loaded" SizeChanged="Window_SizeChanged" Icon="Images/add.png">
    <Grid>
        <Grid.ContextMenu>
            <ContextMenu>
                <MenuItem Header="Check All" Click="CheckAll_Click"/>
                <MenuItem Header="Uncheck All" Click="UncheckAll_Click"/>
                <MenuItem Header="Invert checked items" Click="Invert_Click"/>
            </ContextMenu>
        </Grid.ContextMenu>
        <ListBox x:Name="app_list" Margin="0,35,0,0"/>
        <Button Content="Add" HorizontalAlignment="Right" Margin="0,5,5,0" VerticalAlignment="Top" Width="80" Height="25" Background="{x:Null}" IsDefault="True" Click="Add_Click"/>
        <Button Content="Cancel" HorizontalAlignment="Left" Margin="5,5,0,0" VerticalAlignment="Top" Width="80" Height="25" Background="{x:Null}" IsCancel="True" Click="Cancel_Click"/>
        <TextBlock Margin="90,8,90,0" VerticalAlignment="Top" Foreground="DarkBlue" TextAlignment="Center">
            <Run x:Name="checked_apps"/>
            <Run x:Name="total_apps"/>
        </TextBlock>

    </Grid>
</Window>
