<Window x:Class="App_Launcher.AddAPP"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add APPLICATION" Height="198" Width="350" WindowStartupLocation="CenterScreen" ResizeMode="CanMinimize" FontSize="14" Icon="Images/add.png">
    <Grid>
        <Button Content="Cancel" HorizontalAlignment="Right" Margin="0,0,254,5" VerticalAlignment="Bottom" Width="80" Height="25" Background="{x:Null}" IsCancel="True" Click="Cancel_Click"/>
        <Button Content="OK" HorizontalAlignment="Right" Margin="0,0,10,5" VerticalAlignment="Bottom" Width="80" Height="25" Background="{x:Null}" IsDefault="True" Click="OK_Click"/>
        <TextBlock HorizontalAlignment="Left" Margin="10,10,0,0" TextWrapping="Wrap" Text="Application name:" VerticalAlignment="Top"/>
        <TextBlock HorizontalAlignment="Left" Margin="10,57,0,0" TextWrapping="Wrap" Text="Location:" VerticalAlignment="Top"/>
        <TextBox Name="name" Height="23" Margin="10,29,10,0" TextWrapping="Wrap" VerticalAlignment="Top"/>
        <TextBox Name="location" Height="23" Margin="10,76,50,0" VerticalAlignment="Top" MaxLines="1" IsReadOnly="True"/>
        <Button ToolTip="Browse" HorizontalAlignment="Right" Margin="0,76,10,0" VerticalAlignment="Top" Width="35" Background="{x:Null}" Click="Button_Click" FontSize="9.5" Height="23">
            <Button.Content>
                <Image Source="Images/browser.png" />
            </Button.Content>
        </Button>
        <TextBox Name="priority" HorizontalAlignment="Left" Height="23" Margin="66,104,0,0" TextWrapping="Wrap" Text="0" VerticalAlignment="Top" Width="14" MaxLines="1" MaxLength="1"/>
        <TextBlock HorizontalAlignment="Left" Margin="10,106,0,0" TextWrapping="Wrap" Text="Priority: " VerticalAlignment="Top"/>
        <ComboBox HorizontalAlignment="Left" Margin="169,104,0,0" VerticalAlignment="Top" Width="165" SelectedIndex="0" IsEnabled="False">
            <ComboBoxItem Content="Utility"/>
            <ComboBoxItem Content="Multimedia"/>
            <ComboBoxItem Content="Games"/>
            <ComboBoxItem Content="Internet"/>
            <ComboBoxItem Content="Devloperment"/>
        </ComboBox>
        <TextBlock HorizontalAlignment="Left" Margin="105,107,0,0" TextWrapping="Wrap" Text="Category:" VerticalAlignment="Top" IsEnabled="False"/>
    </Grid>
</Window>
