<Window x:Class="App_Launcher.AddAPP"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add APPLICATION" Height="255" Width="350" WindowStartupLocation="CenterScreen" ResizeMode="NoResize" FontSize="14" Icon="Images/add.png">
    <Grid>
        <Button Content="Cancel" HorizontalAlignment="Right" Margin="0,0,95,5" VerticalAlignment="Bottom" Width="80" Height="25" Background="{x:Null}" IsCancel="True" Click="CancelBtm_Click"/>
        <Button x:Name="OK_button" Content="OK" HorizontalAlignment="Right" Margin="0,0,10,5" VerticalAlignment="Bottom" Width="80" Height="25" Background="{x:Null}" IsDefault="True" Click="OKBtm_Click"/>
        <TextBlock HorizontalAlignment="Left" Margin="63,12,0,0" TextWrapping="Wrap" Text="Name:" VerticalAlignment="Top"/>
        <TextBlock HorizontalAlignment="Left" Margin="10,65,0,0" TextWrapping="Wrap" Text="Location:" VerticalAlignment="Top" RenderTransformOrigin="0.5,0.5">
            <TextBlock.RenderTransform>
                <TransformGroup>
                    <ScaleTransform/>
                    <SkewTransform/>
                    <RotateTransform Angle="1.214"/>
                    <TranslateTransform/>
                </TransformGroup>
            </TextBlock.RenderTransform>
        </TextBlock>
        <Border BorderBrush="#FFABADB3" BorderThickness="1" Height="25" Margin="10,85,10,0" VerticalAlignment="Top">
            <Grid VerticalAlignment="Top">
                <TextBox Name="location" Height="23" VerticalAlignment="Top" MaxLines="1" IsReadOnly="True" BorderThickness="0" Margin="0,0,23,0"/>
                <Button ToolTip="Browse" HorizontalAlignment="Right" Width="23" Background="{x:Null}" Click="BrowseBtm_Click" FontSize="9.5" BorderThickness="0" BorderBrush="#FFABADB3">
                    <Button.Content>
                        <Image Source="Images/browser.png" />
                    </Button.Content>
                </Button>
            </Grid>
        </Border>
        <TextBox Name="name" Margin="63,32,10,0" TextWrapping="Wrap" VerticalAlignment="Top" Height="21"/>
        <TextBlock HorizontalAlignment="Left" Margin="10,120,0,0" TextWrapping="Wrap" Text="Priority: " VerticalAlignment="Top"/>
        <ComboBox Margin="125,151,10,0" VerticalAlignment="Top" SelectedIndex="0" IsEnabled="False">
            <ComboBoxItem Content="Utility"/>
            <ComboBoxItem Content="Multimedia"/>
            <ComboBoxItem Content="Games"/>
            <ComboBoxItem Content="Internet"/>
            <ComboBoxItem Content="Devloperment"/>
        </ComboBox>
        <TextBlock HorizontalAlignment="Left" Margin="10,155,0,0" TextWrapping="Wrap" Text="Category:" VerticalAlignment="Top" IsEnabled="False"/>
        <Slider x:Name="priority" Margin="125,120,10,0" VerticalAlignment="Top" SmallChange="1" Maximum="9" LargeChange="5" AutoToolTipPlacement="TopLeft" TickPlacement="TopLeft" Value="4"/>
        <Image x:Name="image" HorizontalAlignment="Left" Height="48" Margin="10,10,0,0" VerticalAlignment="Top" Width="48" Source="Images/applicaton.png"/>
    </Grid>
</Window>
