<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:Forms="clr-namespace:System.Windows.Forms;assembly=System.Windows.Forms" x:Class="App_Launcher.EditApp"
    
        Title="EditApp" Height="420" Width="466" FontSize="14" MinWidth="380" MinHeight="390" SizeChanged="Window_SizeChanged" Loaded="Window_Loaded" Icon="Images/list.png" Closing="Window_Closing">
    <Window.TaskbarItemInfo>
        <TaskbarItemInfo ProgressState="Normal"/>
    </Window.TaskbarItemInfo>
    <Grid>
        <ListBox Visibility="Hidden" Name="app_list" Margin="0,46,0,0" SelectionMode="Extended" AllowDrop="True" Drop="AppList_Drop"/>
        <Button Content="Save" HorizontalAlignment="Left" Margin="5,22,0,0" VerticalAlignment="Top" Width="50" Height="23" Background="{x:Null}" ToolTip="Save and close" Click="Save_Click"/>
        <Menu FontSize="14" VerticalAlignment="Top">
            <MenuItem Header="ACTION">
                <MenuItem Header="Save" Click="Save_Click"/>
                <Separator/>
                <MenuItem Header="Discard" Click="Discard_Click"/>
            </MenuItem>
            <MenuItem Header="ITEMS">
                <MenuItem Header="Add an app" Click="Add_Click"/>
                <MenuItem Header="Add all apps in a directory"  Click="AddFrom_Click"/>
                <Separator/>
                <MenuItem Header="Delete selected item(s)" Click="DeleteSelected_Click"/>
                <MenuItem Header="Delete checked item(s)" Click="DeleteChecked_Click"/>
            </MenuItem>
            <MenuItem Header="Sort by">
                <MenuItem Header="Name" Click="SortListByName_Click"/>
                <MenuItem Header="Path" Click="SortListByPath_Click"/>
                <MenuItem Header="Priority" Click="SortListByPriority_Click"/>
            </MenuItem>
            <MenuItem Header="EDIT">
                <MenuItem Header="Check all" Click="SelectAll_Click"/>
                <MenuItem Header="Check none" Click="CheckNone_Click"/>
                <MenuItem Header="Invert checked items" Click="Invert_Click"/>
            </MenuItem>
        </Menu>
        <TextBlock x:Name="Count" HorizontalAlignment="Left" Margin="126,21,0,0" VerticalAlignment="Top" FontSize="18" Foreground="RoyalBlue"/>
        <Button Content="Cancel" HorizontalAlignment="Left" Margin="60,22,0,0" VerticalAlignment="Top" Width="50" Height="23" Background="{x:Null}" ToolTip="Close" Click="Discard_Click"/>
        <TextBlock x:Name="loading_tb" Margin="10,180,10,0" TextWrapping="Wrap" Text="Loading..." VerticalAlignment="Top" FontSize="32" TextAlignment="Center"/>
        <Border BorderBrush="Gray" BorderThickness="1" HorizontalAlignment="Right" Height="23" Margin="0,22,5,0" VerticalAlignment="Top" Width="168">
            <Grid>
                <Image x:Name="image" HorizontalAlignment="Right" Source="Images/search-icon.png"/>
                <TextBlock x:Name="filter_placeholder" HorizontalAlignment="Left" TextWrapping="Wrap" Text="filtter" Foreground="Gray" VerticalAlignment="Top" FontStyle="Italic" Margin="6,1,0,0"/>
                <TextBox x:Name="filter_tb" Height="22" TextWrapping="Wrap" VerticalAlignment="Top" Background="Transparent" TextChanged="Filter_TB_TextChanged" Margin="0,0,21,0" BorderThickness="0"/>
            </Grid>
        </Border>
    </Grid>
</Window>
