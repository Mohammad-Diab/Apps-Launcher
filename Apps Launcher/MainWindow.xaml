<Window x:Class="Apps_Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Apps Launcher" Height="425" Width="325" MinHeight="80"  Icon="Images/main_icon.png" MinWidth="200"  LocationChanged="Window_LocationChanged" Loaded="Window_Loaded" Closing="Window_Closing" SizeChanged="Window_SizeChanged" MouseEnter="Window_MouseEnter" Deactivated="Window_Deactivated" MouseLeftButtonDown="Window_MouseLeftButtonDown" ShowInTaskbar="False">
    <Grid MouseLeave="Window_MouseLeave" Background="Transparent">
        <ListBox Name="app_list" Margin="0,29,0,34" BorderThickness="0,1,0,0" BorderBrush="#FF4169E1" PreviewKeyUp="AppList_PreviewKeyUp" AllowDrop="True" Drop="AppList_Drop"/>
        <Border BorderBrush="#FFABADB3" BorderThickness="0,2,0,0" Height="34" VerticalAlignment="Bottom">
            <Grid>
                <TextBlock x:Name="searchbox_placeholder" Margin="7,4,40,0" TextWrapping="Wrap" Text="Search Here" VerticalAlignment="Top" FontSize="18" Foreground="#FF292929" Opacity="0.5" FontStyle="Italic"/>
                <TextBox Name="search" FontSize="22" TextChanged="Search_TextChanged" PreviewKeyUp="Search_PreviewKeyUp"  Background="{x:Null}" BorderThickness="0"/>

                <Image x:Name="image" Height="32" VerticalAlignment="Bottom" HorizontalAlignment="Right" Width="32" Margin="0,0,0,0" Source="Images/search-icon.png" Stretch="Fill"/>
                <Button x:Name="clear_text" HorizontalAlignment="Right" Width="32" Background="White" BorderBrush="{x:Null}" Visibility="Hidden" Click="ClearTextBtm_Click">
                    <Image Source="Images/Clear text.png" Stretch="Fill"/>
                </Button>
            </Grid>
        </Border>
        <Grid x:Name="main_menu_grid" Margin="0,29,0,0" Visibility="Collapsed">
            <Grid Background="#00000000" PreviewMouseDown="Grid_PreviewMouseDown"/>
            <ItemsControl x:Name="main_menu" HorizontalAlignment="Right" Margin="0,-100,0,0" Opacity="0" VerticalAlignment="Top"  Background="#FF404040" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Width="200" BorderBrush="Black" Height="340">
                <MenuItem Header="Hide title bar" Height="25" Click="ShowHide_Click" FontSize="14" Foreground="White" Margin="3">
                    <MenuItem.Icon>
                        <Image x:Name="showtitle_img"  Source="Images/hide-titlebar-tick.png" Stretch="Fill"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Add app" Click="AddApplication_Click" Height="25" FontSize="14" Foreground="White" Margin="3">
                    <MenuItem.Icon>
                        <Image Width="20" Height="20" Source="Images/add-small.png" Stretch="Fill"/>
                    </MenuItem.Icon>
                </MenuItem>
                <Separator Background="#FFF0F0F0" Margin="3"/>
                <MenuItem Header="Restore apps list" FontSize="14" Height="25" Foreground="White" Click="RestoreList_Click" Margin="3">
                    <MenuItem.Icon>
                        <Image Width="20" Height="20" Source="Images/restore-list.png" Stretch="Fill"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Backup apps list" FontSize="14" Height="25" Foreground="White" Click="BackupList_Click" Margin="3">
                    <MenuItem.Icon>
                        <Image Width="20" Height="20" Source="Images/backup-list.png"/>
                    </MenuItem.Icon>
                </MenuItem>
                <Separator Background="#FFF0F0F0" Margin="3"/>
                <MenuItem Header="Edit apps list" Height="25" Click="Edit_Click" FontSize="14" Foreground="White" Margin="3">
                    <MenuItem.Icon>
                        <Image Width="20" Height="20" Source="Images/edit.png" Stretch="Fill"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Check apps list" Height="25" Click="Check_Click" FontSize="14" Foreground="White" Margin="3">
                    <MenuItem.Icon>
                        <Image Width="20" Height="20" Source="Images/check-list.png" Stretch="Fill"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Options" Height="25" Click="Option_Click" FontSize="14" Foreground="White" Margin="3">
                    <MenuItem.Icon>
                        <Image Width="20" Height="20" Source="Images/option.png"/>
                    </MenuItem.Icon>
                </MenuItem>
                <Separator Background="#FFF0F0F0" Margin="3"/>
                <MenuItem Header="About" Height="25" Click="About_Click" FontSize="14" Foreground="White" Margin="3">
                    <MenuItem.Icon>
                        <Image Width="20" Height="20" Source="Images/about.png" Stretch="Fill"/>
                    </MenuItem.Icon>
                </MenuItem>
                <Separator Background="#FFF0F0F0" Margin="3"/>
                <MenuItem Header="Minimize" Height="25" Click="Minimize_Click" FontSize="14" Foreground="White" Margin="3">
                    <MenuItem.Icon>
                        <Image Width="20" Height="20" Source="Images/minimize.png" Stretch="Fill"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Exit" Height="25" Click="Exit_Click" FontSize="14" Foreground="White" Margin="3">
                    <MenuItem.Icon>
                        <Image Width="20" Height="20" Source="Images/exit.png" Stretch="Fill"/>
                    </MenuItem.Icon>
                </MenuItem>
            </ItemsControl>
        </Grid>
        <Grid Height="29" VerticalAlignment="Top">
            <Grid.Background>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="AliceBlue" Offset="0"/>
                    <GradientStop Color="White" Offset="0.5"/>
                </LinearGradientBrush>
            </Grid.Background>
            <TextBlock HorizontalAlignment="Left" Margin="34,5,0,0" TextWrapping="Wrap" Text="Apps Launcher" VerticalAlignment="Top" FontSize="16" Foreground="Gray"/>
            <TextBlock HorizontalAlignment="Left" Margin="34,4,0,0" TextWrapping="Wrap" Text="Apps Launcher" FontSize="16" Foreground="#FF3B97D3" VerticalAlignment="Top"/>
            <Image x:Name="image1" HorizontalAlignment="Left" Margin="5,3,0,2" Width="24" Stretch="Fill" Source="Images/app-launcher.png"/>
            <Grid Background="#00000000" PreviewMouseDown="Grid_PreviewMouseDown"/>
            <Button x:Name="button" HorizontalAlignment="Right" Width="40" Background="#00000000" BorderBrush="{x:Null}" Click="MenuBtm_Click">
                <StackPanel>
                    <Grid x:Name="img_grid" Width="32" Height="25">
                        <Image x:Name="img1" Stretch="None" Source="Images/dot.png" HorizontalAlignment="Left" Margin="0,0,0,0"/>
                        <Image x:Name="img2" Stretch="None" Source="Images/dot.png" HorizontalAlignment="Left" Margin="11,0,0,0"/>
                        <Image x:Name="img3" Stretch="None" Source="Images/dot.png" HorizontalAlignment="Left" Margin="22,0,0,0"/>
                    </Grid>
                    <Image x:Name="img4" Stretch="Fill" Height="25" Width="32" Source="Images/arrow-linear.png" HorizontalAlignment="Left"/>
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</Window>
    
    
