<Window x:Class="Apps_Launcher.ModrenMessageBox"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Apps_Launcher"
        mc:Ignorable="d"
        Title="ModrenMessageBox" Height="154.113" Width="460.15" FontSize="14" ResizeMode="NoResize">
    <Grid>
        <Button x:Name="button" Content="OK" HorizontalAlignment="Right" Margin="0,0,10,10" VerticalAlignment="Bottom" Width="75" Background="Transparent" BorderBrush="ForestGreen" BorderThickness="2,1" Click="OK_Click"/>
        <Button x:Name="button1" Content="Cancel" HorizontalAlignment="Right" Margin="0,0,90,10" VerticalAlignment="Bottom" Width="75" Background="Transparent" BorderBrush="Tomato" BorderThickness="2,1" Click="Cancel_Click"/>
        <TextBox x:Name="textBox" Height="23" Margin="10,34,10,0" TextWrapping="Wrap" VerticalAlignment="Top"/>
        <TextBlock x:Name="textBlock" HorizontalAlignment="Left" Margin="10,10,0,0" TextWrapping="Wrap" Text="Enter command arguments:" VerticalAlignment="Top"/>
        <TextBlock x:Name="textBlock1" HorizontalAlignment="Left" Margin="10,62,0,0" TextWrapping="Wrap" Text="leave empty tor run command only." VerticalAlignment="Top" FontSize="12
                   " Foreground="RoyalBlue"/>

    </Grid>
</Window>
